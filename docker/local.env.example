# Copy to docker/local.env (git-ignored) and fill in for your deployment.
# Docker host that builds and runs the runtime images.
TARGET_DOCKER_HOST=ssh://myserver
# SSH host and directory of the docker-compose deployment.
DEPLOY_HOST=myserver
DEPLOY_DIR=/path/to/docspell-compose
# PostgreSQL container holding the docspell DB.
PG_CONTAINER=postgres
# Languages that get tessdata_best OCR models in the joex image (default: "eng osd").
TESSDATA_BEST_LANGS="eng osd"
